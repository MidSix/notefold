{
  "name": "notefold",
  "displayName": "NoteFold — Inline Code Notes with LaTeX & Mermaid",
  "description": "Markdown notes anchored to lines of code, stored in the file itself as regular comments. Folded out of the way, with colour bars, inline titles, and LaTeX & Mermaid rendering.",
  "version": "0.1.0",
  "publisher": "MidSix",
  "author": {
    "name": "Sebastián David Moreno Expósito",
    "url": "https://github.com/MidSix"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MidSix/notefold.git"
  },
  "homepage": "https://github.com/MidSix/notefold#readme",
  "bugs": {
    "url": "https://github.com/MidSix/notefold/issues"
  },
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "notes",
    "annotations",
    "comments",
    "documentation",
    "latex",
    "mermaid",
    "markdown",
    "codetour",
    "claude"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "notefold.add",
        "title": "Añadir nota a la selección",
        "category": "NoteFold",
        "icon": "$(comment)"
      },
      {
        "command": "notefold.open",
        "title": "Abrir nota",
        "category": "NoteFold"
      },
      {
        "command": "notefold.edit",
        "title": "Editar nota",
        "category": "NoteFold"
      },
      {
        "command": "notefold.delete",
        "title": "Borrar nota",
        "category": "NoteFold"
      },
      {
        "command": "notefold.deleteAll",
        "title": "Borrar todas las notas del archivo",
        "category": "NoteFold"
      },
      {
        "command": "notefold.next",
        "title": "Siguiente nota",
        "category": "NoteFold",
        "icon": "$(arrow-down)"
      },
      {
        "command": "notefold.previous",
        "title": "Nota anterior",
        "category": "NoteFold",
        "icon": "$(arrow-up)"
      },
      {
        "command": "notefold.reveal",
        "title": "Ir a la nota",
        "category": "NoteFold"
      },
      {
        "command": "notefold.regenerateId",
        "title": "Regenerar id de la nota",
        "category": "NoteFold"
      },
      {
        "command": "notefold.gutter.create",
        "title": "Crear nota",
        "category": "NoteFold"
      },
      {
        "command": "notefold.gutter.cancel",
        "title": "Cancelar",
        "category": "NoteFold"
      },
      {
        "command": "notefold.gutter.color.blue",
        "title": "Color: Azul",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-blue-light.svg",
          "dark": "media/color-blue-dark.svg"
        }
      },
      {
        "command": "notefold.gutter.color.green",
        "title": "Color: Verde",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-green-light.svg",
          "dark": "media/color-green-dark.svg"
        }
      },
      {
        "command": "notefold.gutter.color.yellow",
        "title": "Color: Amarillo",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-yellow-light.svg",
          "dark": "media/color-yellow-dark.svg"
        }
      },
      {
        "command": "notefold.gutter.color.red",
        "title": "Color: Rojo",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-red-light.svg",
          "dark": "media/color-red-dark.svg"
        }
      },
      {
        "command": "notefold.gutter.color.purple",
        "title": "Color: Morado",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-purple-light.svg",
          "dark": "media/color-purple-dark.svg"
        }
      },
      {
        "command": "notefold.gutter.selected.blue",
        "title": "Color: Azul (elegido)",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-blue-light-selected.svg",
          "dark": "media/color-blue-dark-selected.svg"
        }
      },
      {
        "command": "notefold.gutter.selected.green",
        "title": "Color: Verde (elegido)",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-green-light-selected.svg",
          "dark": "media/color-green-dark-selected.svg"
        }
      },
      {
        "command": "notefold.gutter.selected.yellow",
        "title": "Color: Amarillo (elegido)",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-yellow-light-selected.svg",
          "dark": "media/color-yellow-dark-selected.svg"
        }
      },
      {
        "command": "notefold.gutter.selected.red",
        "title": "Color: Rojo (elegido)",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-red-light-selected.svg",
          "dark": "media/color-red-dark-selected.svg"
        }
      },
      {
        "command": "notefold.gutter.selected.purple",
        "title": "Color: Morado (elegido)",
        "category": "NoteFold",
        "icon": {
          "light": "media/color-purple-light-selected.svg",
          "dark": "media/color-purple-dark-selected.svg"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "notefold.reveal",
          "when": "false"
        },
        {
          "command": "notefold.regenerateId",
          "when": "false"
        },
        {
          "command": "notefold.gutter.create",
          "when": "false"
        },
        {
          "command": "notefold.gutter.cancel",
          "when": "false"
        },
        {
          "command": "notefold.gutter.color.blue",
          "when": "false"
        },
        {
          "command": "notefold.gutter.color.green",
          "when": "false"
        },
        {
          "command": "notefold.gutter.color.yellow",
          "when": "false"
        },
        {
          "command": "notefold.gutter.color.red",
          "when": "false"
        },
        {
          "command": "notefold.gutter.color.purple",
          "when": "false"
        },
        {
          "command": "notefold.gutter.selected.blue",
          "when": "false"
        },
        {
          "command": "notefold.gutter.selected.green",
          "when": "false"
        },
        {
          "command": "notefold.gutter.selected.yellow",
          "when": "false"
        },
        {
          "command": "notefold.gutter.selected.red",
          "when": "false"
        },
        {
          "command": "notefold.gutter.selected.purple",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "notefold.add",
          "group": "notefold@1",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "notefold.previous",
          "when": "view == notefold.fileNotes",
          "group": "navigation@1"
        },
        {
          "command": "notefold.next",
          "when": "view == notefold.fileNotes",
          "group": "navigation@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "notefold.gutter.create",
          "group": "inline@1",
          "when": "commentController == notefold"
        },
        {
          "command": "notefold.gutter.cancel",
          "group": "inline@2",
          "when": "commentController == notefold"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "notefold.gutter.color.blue",
          "group": "inline@1",
          "when": "commentController == notefold && commentThread && commentThread != notefold.color.blue"
        },
        {
          "command": "notefold.gutter.selected.blue",
          "group": "inline@1",
          "when": "commentController == notefold && (commentThread == notefold.color.blue || !commentThread)"
        },
        {
          "command": "notefold.gutter.color.green",
          "group": "inline@2",
          "when": "commentController == notefold && commentThread != notefold.color.green"
        },
        {
          "command": "notefold.gutter.selected.green",
          "group": "inline@2",
          "when": "commentController == notefold && commentThread == notefold.color.green"
        },
        {
          "command": "notefold.gutter.color.yellow",
          "group": "inline@3",
          "when": "commentController == notefold && commentThread != notefold.color.yellow"
        },
        {
          "command": "notefold.gutter.selected.yellow",
          "group": "inline@3",
          "when": "commentController == notefold && commentThread == notefold.color.yellow"
        },
        {
          "command": "notefold.gutter.color.red",
          "group": "inline@4",
          "when": "commentController == notefold && commentThread != notefold.color.red"
        },
        {
          "command": "notefold.gutter.selected.red",
          "group": "inline@4",
          "when": "commentController == notefold && commentThread == notefold.color.red"
        },
        {
          "command": "notefold.gutter.color.purple",
          "group": "inline@5",
          "when": "commentController == notefold && commentThread != notefold.color.purple"
        },
        {
          "command": "notefold.gutter.selected.purple",
          "group": "inline@5",
          "when": "commentController == notefold && commentThread == notefold.color.purple"
        }
      ]
    },
    "keybindings": [
      {
        "command": "notefold.add",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "notefold.open",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus"
      },
      {
        "command": "notefold.next",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "editorTextFocus"
      },
      {
        "command": "notefold.previous",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "editorTextFocus"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "notefold.fileNotes",
          "name": "Notas del archivo actual"
        }
      ]
    },
    "colors": [
      {
        "id": "notefold.blueRuler",
        "description": "Marca en la regla de vista general de las notas de color azul.",
        "defaults": {
          "light": "#1a73e8aa",
          "dark": "#3794ffaa",
          "highContrast": "#3794ff",
          "highContrastLight": "#1a73e8"
        }
      },
      {
        "id": "notefold.greenRuler",
        "description": "Marca en la regla de vista general de las notas de color verde.",
        "defaults": {
          "light": "#1e8e3eaa",
          "dark": "#3fb950aa",
          "highContrast": "#3fb950",
          "highContrastLight": "#1e8e3e"
        }
      },
      {
        "id": "notefold.yellowRuler",
        "description": "Marca en la regla de vista general de las notas de color amarillo.",
        "defaults": {
          "light": "#b08800aa",
          "dark": "#d29922aa",
          "highContrast": "#d29922",
          "highContrastLight": "#b08800"
        }
      },
      {
        "id": "notefold.redRuler",
        "description": "Marca en la regla de vista general de las notas de color rojo.",
        "defaults": {
          "light": "#d93025aa",
          "dark": "#f85149aa",
          "highContrast": "#f85149",
          "highContrastLight": "#d93025"
        }
      },
      {
        "id": "notefold.purpleRuler",
        "description": "Marca en la regla de vista general de las notas de color morado.",
        "defaults": {
          "light": "#8250dfaa",
          "dark": "#a371f7aa",
          "highContrast": "#a371f7",
          "highContrastLight": "#8250df"
        }
      }
    ],
    "configuration": {
      "title": "NoteFold",
      "properties": {
        "notefold.displayMode": {
          "type": "string",
          "enum": [
            "fold",
            "dim",
            "off"
          ],
          "enumDescriptions": [
            "Pliega la cabecera y el cuerpo de cada nota y atenúa los marcadores visibles.",
            "No pliega; atenúa todo el bloque de la nota.",
            "Muestra el bloque tal cual (solo indicador en el margen)."
          ],
          "default": "fold",
          "description": "Cómo se muestran los bloques de nota en el editor."
        },
        "notefold.gutterBar": {
          "type": "boolean",
          "default": true,
          "description": "Dibuja una barra vertical del color de la nota en el margen de cada línea de código anotado."
        },
        "notefold.gutterAddButton": {
          "type": "boolean",
          "default": true,
          "description": "Muestra el botón + en el margen para crear una nota en las líneas de código que no son comentarios ni forman parte de otra nota."
        },
        "notefold.showNoteOnLineNumberClick": {
          "type": "boolean",
          "default": true,
          "description": "Al hacer clic en el número de una línea anotada (junto a la barra de color) se muestra la nota, igual que al pasar el ratón por @note-start."
        },
        "notefold.inlineTitle": {
          "type": "boolean",
          "default": true,
          "description": "Muestra el título de la nota (su primera línea) como texto tenue al final de la primera línea de código anotado. Pasar el ratón por ese texto muestra la nota completa."
        },
        "notefold.hideMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Hace invisibles las líneas @note-start, @note-body-end y @note-end (quedan como líneas en blanco). Reaparecen al editar la nota o al poner el cursor sobre ellas. No se aplica con displayMode: off."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "notefold.fileNotes",
        "contents": "No hay notas en el archivo actual.\n[Añadir nota a la selección](command:notefold.add)"
      }
    ],
    "configurationDefaults": {
      "editor.foldingHighlight": false
    }
  },
  "scripts": {
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integration": "npm run compile && tsc -p test/integration && node out/test/integration/runTest.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "try": "npm run compile && node try.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
